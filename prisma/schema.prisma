// Prisma schema for Admin model (Prisma v6 syntax)

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model Admin {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    mobile    String   @unique
    password  String
    role      Role     @default(ADMIN)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum Role {
    ADMIN
    SUPER_ADMIN
}

model Category {
    id              Int                  @id @default(autoincrement())
    name            String               @unique
    icon            String?
    isActive        Boolean              @default(true)
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt
    technicians     TechnicianCategory[]
    jobs            Job[]
    spares          Spare[]
    spareCategories SpareCategory[]
}

model Technician {
    id                  Int                  @id @default(autoincrement())
    name                String
    mobile              String               @unique
    email               String?
    password            String
    profileImage        String?
    status              TechnicianStatus     @default(ACTIVE)
    isActive            Boolean              @default(true)
    createdAt           DateTime             @default(now())
    updatedAt           DateTime             @updatedAt
    experience          Int
    rating              Float
    categories          TechnicianCategory[]
    jobs                Job[]
    customSpareRequests CustomSpareRequest[]
    wallet              Wallet?
    walletTransactions  WalletTransaction[]
    payouts             Payout[]
}

enum TechnicianStatus {
    ACTIVE
    INACTIVE
    WARNING
    BLOCKED
    SUSPENDED
}

model TechnicianCategory {
    id           Int        @id @default(autoincrement())
    technician   Technician @relation(fields: [technicianId], references: [id])
    technicianId Int
    category     Category   @relation(fields: [categoryId], references: [id])
    categoryId   Int

    @@unique([technicianId, categoryId])
}

model Customer {
    id        Int       @id @default(autoincrement())
    name      String?
    mobile    String    @unique
    otpCode   String?
    otpExpiry DateTime?
    isActive  Boolean   @default(true)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    jobs      Job[]
}

model Job {
    id              Int          @id @default(autoincrement())
    jobCode         String       @unique
    customerName    String
    customerPhone   String
    address         String
    latitude        Decimal?     @db.Decimal(10, 8)
    longitude       Decimal?     @db.Decimal(11, 8)
    description     String
    category        Category     @relation(fields: [categoryId], references: [id])
    categoryId      Int
    technician      Technician?  @relation(fields: [technicianId], references: [id])
    technicianId    Int?
    customer        Customer?    @relation(fields: [customerId], references: [id])
    customerId      Int?
    status          JobStatus    @default(CREATED)
    scheduleTime    DateTime
    totalAmount     Float        @default(0)
    technicianShare Float        @default(0)
    companyShare    Float        @default(0)
    isDeleted       Boolean      @default(false)
    beforeImage     String?
    afterImage      String?
    jobStartTime    DateTime?
    jobEndTime      DateTime?
    duration        Int?
    rejectReason    String?
    rejectedAt      DateTime?
    paymentMethod   String?
    otpCode         String?
    otpVerified     Boolean      @default(false)
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt
    payments        Payment[]
    spareUsages     SpareUsage[]
    jobScopes       JobScope[]
}

model Spare {
    id              Int             @id @default(autoincrement())
    name            String
    sku             String          @unique
    category        Category?       @relation(fields: [categoryId], references: [id])
    categoryId      Int?
    spareCategory   SpareCategory?  @relation(fields: [spareCategoryId], references: [id])
    spareCategoryId Int?
    brand           Brand?          @relation(fields: [brandId], references: [id])
    brandId         Int?
    costPrice       Float
    sellingPrice    Float
    stockQty        Int             @default(0)
    minStock        Int             @default(5)
    isActive        Boolean         @default(true)
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    usages          SpareUsage[]
    stockLogs       SpareStockLog[]
}

model SpareCategory {
    id            Int      @id @default(autoincrement())
    name          String
    jobCategory   Category @relation(fields: [jobCategoryId], references: [id])
    jobCategoryId Int
    isActive      Boolean  @default(true)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
    spares        Spare[]

    @@unique([name, jobCategoryId])
}

model Brand {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    spares    Spare[]
}

model SpareUsage {
    id         Int      @id @default(autoincrement())
    jobId      Int
    spareId    Int
    quantity   Int
    totalPrice Float
    createdAt  DateTime @default(now())

    job   Job   @relation(fields: [jobId], references: [id])
    spare Spare @relation(fields: [spareId], references: [id])
}

model SpareStockLog {
    id        Int      @id @default(autoincrement())
    spareId   Int
    changeQty Int
    type      String // ADD / DEDUCT
    note      String?
    createdAt DateTime @default(now())

    spare Spare @relation(fields: [spareId], references: [id])
}

model Payment {
    id            Int       @id @default(autoincrement())
    job           Job       @relation(fields: [jobId], references: [id])
    jobId         Int
    amount        Float
    method        String // CASH / UPI / ONLINE
    status        String    @default("PENDING") // PENDING / PAID / FAILED
    transactionId String?
    paidAt        DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
}

model Wallet {
    id           Int      @id @default(autoincrement())
    technicianId Int      @unique
    balance      Float    @default(0)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    technician Technician @relation(fields: [technicianId], references: [id])
}

model WalletTransaction {
    id           Int      @id @default(autoincrement())
    technicianId Int
    amount       Float
    type         String // CREDIT / DEBIT
    source       String // JOB / PAYOUT
    referenceId  Int?
    description  String?
    createdAt    DateTime @default(now())

    technician Technician @relation(fields: [technicianId], references: [id])
}

model Payout {
    id           Int      @id @default(autoincrement())
    technicianId Int
    amount       Float
    status       String   @default("PENDING") // PENDING / APPROVED / PAID
    adminNote    String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    technician Technician @relation(fields: [technicianId], references: [id])
}

enum JobStatus {
    CREATED
    ASSIGNED
    ACCEPTED
    IN_PROGRESS
    WAITING_APPROVAL
    WAITING_OTP
    COMPLETED
    CLOSED
    REJECTED
}

model CustomSpareRequest {
    id           Int      @id @default(autoincrement())
    technicianId Int
    jobId        Int?
    name         String
    category     String
    reason       String
    image        String?
    status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
    adminNote    String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    technician Technician @relation(fields: [technicianId], references: [id])
}

model CompanyPaymentSettings {
    id           Int      @id @default(autoincrement())
    upiId        String?
    mobileNumber String?
    qrImage      String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model ScopeOfWork {
    id            Int         @id @default(autoincrement())
    name          String
    jobCategoryId Int
    status        ScopeStatus @default(PENDING)
    createdBy     CreatedBy   @default(TECHNICIAN)
    createdAt     DateTime    @default(now())
    jobScopes     JobScope[]

    @@unique([name, jobCategoryId])
}

enum ScopeStatus {
    PENDING
    APPROVED
    REJECTED
}

enum CreatedBy {
    ADMIN
    TECHNICIAN
}

model JobScope {
    id            Int      @id @default(autoincrement())
    jobId         Int
    scopeOfWorkId Int
    createdAt     DateTime @default(now())

    job   Job         @relation(fields: [jobId], references: [id])
    scope ScopeOfWork @relation(fields: [scopeOfWorkId], references: [id])
}
